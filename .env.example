# Lakebase
LAKEBASE_URL=
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url
LAKEBASE_CONNECT_TIMEOUT=10

# External APIs
OPEN_METEO_TIMEOUT_SECONDS=10
WIKIMEDIA_TIMEOUT_SECONDS=15
WIKIMEDIA_USER_AGENT=DetourCapstone/0.1 (educational project)

# Databricks AI Gateway
DATABRICKS_TOKEN=
DATABRICKS_AI_BASE_URL=https://YOUR_WORKSPACE_HOST/ai-gateway/mlflow/v1
DATABRICKS_CHAT_MODEL=system.ai.meta-llama-3-3-70b-instruct
DATABRICKS_LLM_TIMEOUT_SECONDS=120

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_THREADS=2

# App
LOG_LEVEL=INFO
AUTO_INIT_DB=true
